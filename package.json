{
  "name": "frontend-skills",
  "version": "0.1.0",
  "description": "Skills and a rule dictionary for AI coding agents that write front-end code, fitted to your project's stack and checked by a static audit.",
  "type": "module",
  "license": "MIT",
  "author": "Dawid Olko (https://dawidolko.pl)",
  "homepage": "https://skills.dawidolko.pl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawidolko/frontend-skills.git"
  },
  "bugs": "https://github.com/dawidolko/frontend-skills/issues",
  "bin": {
    "frontend-skills": "cli/index.mjs"
  },
  "files": [
    "cli",
    "engine",
    "adapters",
    "rules",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 \"test/*.test.mjs\"",
    "validate": "node tools/validate.mjs",
    "headers": "node tools/check-headers.mjs",
    "links": "node tools/check-links.mjs",
    "links:online": "node tools/check-links.mjs --online",
    "tokens": "node tools/calibrate-tokens.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "biome check . && node tools/validate.mjs && node tools/check-headers.mjs && node tools/check-links.mjs && node tools/calibrate-tokens.mjs --check && node --test --test-concurrency=4 \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "gpt-tokenizer": "4.1.2"
  },
  "keywords": [
    "agent-skills",
    "accessibility",
    "wcag",
    "lighthouse",
    "frontend",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "gemini-cli"
  ]
}
